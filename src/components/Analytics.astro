---
// Cloudflare Web Analytics beacon, in the <head> of every page (BaseLayout). See src/lib/analytics.ts.
import { ANALYTICS_HOST, CLOUDFLARE_BEACON_TOKEN } from '../lib/analytics';
---

{
  CLOUDFLARE_BEACON_TOKEN && (
    <script is:inline define:vars={{ token: CLOUDFLARE_BEACON_TOKEN, host: ANALYTICS_HOST }}>
      if (location.hostname === host) {
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
        document.head.appendChild(s);
      }
    </script>
  )
}
