---
// Canonical URL and link-preview tags (Open Graph, Twitter), shared by every page through BaseLayout.
// The canonical always ends in "/": the site builds one folder per page, and GitHub Pages
// redirects /manual to /manual/, so the slash form is the one that answers 200 directly.
interface Props {
  title: string;
  description: string;
  /** Path of the share image under public/, 1200x630. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  image = '/og-image.png',
  imageAlt = 'Makonome: precision metronome and practice tracker for iPhone, iPad, Mac and Android',
} = Astro.props;

const site = Astro.site ?? new URL('https://makonome.com');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
---

<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Makonome" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
