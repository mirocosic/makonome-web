---
// App Store and Google Play buttons.
import { APP_STORE_URL, GOOGLE_PLAY_URL } from '../../lib/stores';
---

<div class="stores">
  <a href={APP_STORE_URL} class="store-btn" target="_blank" rel="noopener">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
      ></path>
    </svg>
    <span><small>Download on the</small>App Store</span>
  </a>
  <a href={GOOGLE_PLAY_URL} class="store-btn" target="_blank" rel="noopener">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M5 2.6v18.8a.8.8 0 0 0 1.2.7l15-9.4a.8.8 0 0 0 0-1.4L6.2 1.9A.8.8 0 0 0 5 2.6z"></path>
    </svg>
    <span><small>Get it on</small>Google Play</span>
  </a>
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.6rem 1.25rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.1;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .store-btn span {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .store-btn small {
    font-size: 0.7rem;
    font-weight: 500;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.1);
    text-decoration: none;
  }
</style>
