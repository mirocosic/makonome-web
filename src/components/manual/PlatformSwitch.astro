---
import { PLATFORMS, PLATFORM_LABELS } from '../../lib/manual';
---

<div class="platform-switch" role="radiogroup" aria-label="Show the manual for">
  {
    PLATFORMS.map((p) => (
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-platform-choice={p}>
        {PLATFORM_LABELS[p]}
      </button>
    ))
  }
</div>

<script>
  import { PLATFORMS, PLATFORM_STORAGE_KEY } from '../../lib/platforms';

  const root = document.documentElement;

  function sync() {
    const current = root.dataset.platform;
    document.querySelectorAll<HTMLButtonElement>('[data-platform-choice]').forEach((b) => {
      const on = b.dataset.platformChoice === current;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    });
  }

  function choose(p: string, focus: boolean) {
    root.dataset.platform = p;
    try {
      localStorage.setItem(PLATFORM_STORAGE_KEY, p);
    } catch {}
    // Keep a ?platform= link in step with the choice, or a reload would undo it.
    const url = new URL(location.href);
    if (url.searchParams.has('platform')) {
      url.searchParams.set('platform', p);
      history.replaceState(history.state, '', url);
    }
    sync();
    if (focus) {
      document.querySelector<HTMLButtonElement>(`[data-platform-choice="${p}"]`)?.focus();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-platform-choice]').forEach((b) => {
    b.addEventListener('click', () => choose(b.dataset.platformChoice!, false));
    b.addEventListener('keydown', (e) => {
      const i = PLATFORMS.indexOf(b.dataset.platformChoice as (typeof PLATFORMS)[number]);
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % PLATFORMS.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i + PLATFORMS.length - 1) % PLATFORMS.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = PLATFORMS.length - 1;
      if (next < 0) return;
      e.preventDefault();
      choose(PLATFORMS[next], true);
    });
  });

  sync();
</script>

<style>
  .platform-switch {
    display: inline-flex;
    background: var(--color-surface);
    border: 1px solid #333;
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }

  /* Without JavaScript every platform is shown, so the switch would do nothing. */
  :global(html:not([data-platform])) .platform-switch {
    display: none;
  }

  button {
    font: inherit;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--color-text);
  }

  button[aria-checked='true'] {
    background: var(--color-accent);
    color: #0a0a0a;
    font-weight: 600;
  }

  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
