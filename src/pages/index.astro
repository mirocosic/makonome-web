---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import Footer from '../components/Footer.astro';
import Icon, { type IconName } from '../components/home/Icon.astro';
import Phone from '../components/home/Phone.astro';
import StoreButtons from '../components/home/StoreButtons.astro';
import { GOOGLE_PLAY_URL } from '../lib/stores';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import metronomeMain from '../assets/screenshots/metronome-main.png';
import meter78 from '../assets/screenshots/meter-7-8.png';
import timeSignatureSheet from '../assets/screenshots/time-signature-sheet.png';
import visualizationCircular from '../assets/screenshots/visualization-circular.png';
import tempoChanger from '../assets/screenshots/screen-5.png';
import gapTrainer from '../assets/screenshots/gap-trainer.png';
import macTrainerLive from '../assets/screenshots/mac-trainer-live.png';

// The one place the Pro price lives.
const PRO_PRICE = '€4.99 / $4.99';

interface Shot {
  src: ImageMetadata;
  alt: string;
}

interface Feature {
  icon: IconName;
  title: string;
  text: string;
  note?: string;
  // Phone screenshots, or one Mac window shown wide.
  phones?: Shot[];
  mac?: Shot;
}

const features: Feature[] = [
  {
    icon: 'meter',
    title: 'Odd meters, subdivisions and rests',
    text: 'Any meter from 1 to 16 beats over 2, 4, 8 or 16. Split the beat into eighths, sixteenths, triplets up to septuplets, and tap a note to make it a rest. Odd meters show their accent groups (7/8 · 2+2+3), and 6/8, 9/8 and 12/8 can count the dotted beat or every eighth.',
    phones: [
      { src: meter78, alt: 'Metronome in 7/8 with beats grouped 2+2+3' },
      { src: timeSignatureSheet, alt: 'Time signature sheet with Septuplets picked and rests on notes 3 and 6' },
    ],
  },
  {
    icon: 'mute',
    title: 'Gap Trainer and Tempo Changer',
    text: 'Build your internal clock with periodic silent intervals. Then raise the tempo gradually, over time or over bars, to push your limits.',
    phones: [
      { src: gapTrainer, alt: 'Metronome with the Gap Trainer in a muted bar' },
      { src: tempoChanger, alt: 'Tempo Changer' },
    ],
  },
  {
    icon: 'target',
    title: 'Accuracy Trainer',
    text: 'On iPhone, iPad and Mac, play an electronic drum kit over MIDI and see live timing for every hit. Practice mode hides the numbers until a short summary, and Free Time mode silences the click and tracks your tempo drift. Part of Pro.',
    note: 'Experimental: turn it on in Settings → Experimental Features. Shown on Mac.',
    mac: { src: macTrainerLive, alt: 'Accuracy Trainer on Mac showing live timing for each drum' },
  },
  {
    icon: 'eye',
    title: 'Visualizations',
    text: 'Pendulum, Circular, Count and Line views move exactly with the click you hear, at 120 Hz on ProMotion iPhones.',
    phones: [{ src: visualizationCircular, alt: 'Circular visualization in 7/8 with gaps between the accent groups' }],
  },
];

const more: { icon: IconName; title: string; text: string }[] = [
  { icon: 'clock', title: 'Sample-accurate timing', text: 'Rock-solid timing from 20 to 400 BPM, on every platform.' },
  { icon: 'wave', title: 'Five sounds', text: 'Click, clave, woodblock, cowbell or a spoken count, with adjustable pitch.' },
  {
    icon: 'timer',
    title: 'Count-in and auto stop',
    text: 'Count in 1, 2 or 4 bars with a click or a voice count. Stop after a number of bars or a set time, with a bar counter on screen. A soft screen flash to see the beat.',
  },
  { icon: 'list', title: 'Play a collection', text: 'Step through a setlist with buttons, arrow keys or a Bluetooth foot pedal.' },
  { icon: 'chart', title: 'Practice tracking', text: 'Session history and streaks. Widgets on the home and lock screen on iPhone and iPad, the desktop on Mac and the home screen on Android.' },
  { icon: 'laptop', title: 'Native on Mac', text: 'Space plays and stops, the arrow keys change the tempo, and the Accuracy Trainer opens in its own resizable window. A menu bar menu and Ableton Link. On the Mac App Store.',
   },
];

const freeForever = [
  'Metronome',
  'Time signatures',
  'Count-in and auto stop',
  'Screen flash',
  'Visualizations',
  'Practice history and streaks',
  'Widgets',
  'iCloud backup (iPhone, iPad and Mac)',
];

const proIncludes = [
  'Everything else, including the Accuracy Trainer (iPhone, iPad and Mac)',
  'All future upgrades',
  'No subscription, no ads',
];

// Mac window in a feature row: half of the 1056 px content width minus the gap on wide
// screens, full width (less the 20 px gutters) under 860 px. The source is 2880 px wide.
const macWidths = [400, 496, 800, 992, 1488];
const macSizes = '(max-width: 860px) calc(100vw - 40px), 496px';
const macFull = await getImage({ src: macTrainerLive, width: 1440, format: 'webp' });
---

<BaseLayout title="Makonome - Precision Metronome for iPhone, iPad, Mac and Android">
  <main>
    <section class="hero">
      <div class="hero-text">
        <p class="brand">Makonome</p>
        <h1>Count odd meters exactly. Then train your inner clock.</h1>
        <p class="lede">
          A metronome for 7/8, septuplets and subdivisions with rests, with a Gap Trainer that mutes bars so you keep
          the time yourself. The core metronome is free.
        </p>
        <StoreButtons />
        <p class="platforms">iPhone, iPad, Mac and Android · <a href="/manual/">Read the manual →</a></p>
      </div>
      <div class="hero-phone">
        <Phone
          src={metronomeMain}
          alt="Makonome metronome app showing BPM dial at 120 Allegro"
          width={260}
          mobileWidth={220}
          eager
        />
      </div>
    </section>

    <section class="rows" aria-label="Features">
      {
        features.map((f, i) => (
          <article class:list={['row', { flip: i % 2 === 1 }]}>
            <div class="row-text">
              <span class="row-icon">
                <Icon name={f.icon} />
              </span>
              <h2>{f.title}</h2>
              <p>{f.text}</p>
              {f.note && <p class="note">{f.note}</p>}
            </div>
            <div class="row-media">
              {f.mac && (
                <div class="mac-shot" data-lightbox data-lightbox-src={macFull.src} data-lightbox-shape="window">
                  <Image
                    src={f.mac.src}
                    alt={f.mac.alt}
                    width={496}
                    widths={macWidths}
                    sizes={macSizes}
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              {f.phones?.map((shot) => (
                <Phone src={shot.src} alt={shot.alt} width={200} mobileWidth={150} lightbox />
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <section class="more">
      <h2>Also in the box</h2>
      <ul>
        {
          more.map((m) => (
            <li>
              <Icon name={m.icon} size={22} />
              <div>
                <strong>{m.title}</strong>
                <span>{m.text}</span>
              </div>
            </li>
          ))
        }
        <li>
          <Icon name="phone" size={22} />
          <div>
            <strong>On Android too</strong>
            <span
              >Same metronome on Android phones. <a href={GOOGLE_PLAY_URL} target="_blank" rel="noopener"
                >Get it on Google Play</a
              >.</span
            >
          </div>
        </li>
      </ul>
    </section>

    <section class="pricing">
      <h2>Pricing</h2>
      <div class="card">
        <div class="tier free">
          <h3>Free forever</h3>
          <p class="tier-sub">No account, no ads. These stay free after the trial:</p>
          <ul>
            {
              freeForever.map((item) => (
                <li>
                  <Icon name="check" size={18} />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="tier pro">
          <div class="pro-head">
            <h3>Pro</h3>
            <p class="price">{PRO_PRICE} <span>one-time</span></p>
          </div>
          <p class="price-note">Other countries: your app store shows your local price.</p>
          <ul>
            {
              proIncludes.map((item) => (
                <li>
                  <Icon name="check" size={18} />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="platform-note">
            One Pro purchase covers iPhone, iPad and Mac. Pro on Android is a separate purchase in Google Play.
          </p>
          <p class="trial">14-day free trial of everything</p>
          <p class="refund">Not happy? Get a refund through the App Store or Google Play.</p>
        </div>
      </div>
    </section>

    <Lightbox />

    <Footer />
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: min(720px, 100vh);
    padding: 2rem 0;
  }

  .brand {
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .lede {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.55;
    margin-bottom: 1.75rem;
    max-width: 34rem;
  }

  .platforms {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* Links inside running text get an underline, not just the accent colour. */
  .platforms a,
  .more span a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .hero-phone {
    display: flex;
    justify-content: center;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding: 4rem 0;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .row.flip .row-text {
    order: 2;
  }

  .row-icon {
    display: inline-flex;
    padding: 0.6rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .row h2 {
    font-size: 1.9rem;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .row p {
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .row .note {
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }

  .row-media {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
  }

  /* Two phones overlap, the second one lower. */
  .row-media :global(.phone + .phone) {
    margin-left: -40px;
    margin-top: 60px;
  }

  .mac-shot {
    width: 100%;
  }

  .mac-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid #333;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .more {
    padding: 3rem 0;
  }

  .more h2,
  .pricing h2 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }

  .more ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem 2rem;
  }

  .more li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    color: var(--color-accent);
  }

  .more li :global(.icon) {
    flex: none;
  }

  .more li div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .more strong {
    color: var(--color-text);
  }

  .more span {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .pricing {
    padding: 4rem 0;
  }

  .card {
    max-width: 560px;
    border-radius: 24px;
    border: 1px solid #333;
    overflow: hidden;
    background: var(--color-surface);
  }

  .tier {
    padding: 2rem;
  }

  .tier h3 {
    font-size: 1.4rem;
  }

  .pro {
    border-top: 1px solid #333;
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .tier-sub {
    color: var(--color-text-muted);
    margin: 0.25rem 0 1rem;
  }

  .card ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
  }

  .pro ul {
    grid-template-columns: 1fr;
    margin: 1rem 0;
  }

  .card li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--color-text-muted);
  }

  .card li :global(.icon) {
    color: var(--color-accent);
    flex: none;
  }

  .pro-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .price {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.3rem;
  }

  .price span {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .price-note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  .platform-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .trial {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 50px;
  }

  .refund {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 860px) {
    main {
      padding: 0 1.25rem;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 2rem;
      padding-top: 1.5rem;
    }

    .lede {
      font-size: 1rem;
      margin-bottom: 1.25rem;
    }

    .rows {
      gap: 4rem;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .row.flip .row-text {
      order: 0;
    }

    .card ul {
      grid-template-columns: 1fr;
    }
  }
</style>
