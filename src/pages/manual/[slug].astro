---
import { render } from 'astro:content';
import ManualLayout from '../../layouts/ManualLayout.astro';
import ComingSoon from '../../components/manual/ComingSoon.astro';
import Experimental from '../../components/manual/Experimental.astro';
import Platform from '../../components/manual/Platform.astro';
import Pro from '../../components/manual/Pro.astro';
import Screenshot from '../../components/manual/Screenshot.astro';
import { getManualPages, type ManualEntry } from '../../lib/manual';

export async function getStaticPaths() {
  const pages = await getManualPages();
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: ManualEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// MDX pages use these without importing them.
const components = { ComingSoon, Experimental, Platform, Pro, Screenshot };
---

<ManualLayout
  title={entry.data.title}
  description={entry.data.description}
  current={entry.id}
  headings={headings}
  platforms={entry.data.platforms}
>
  <Content components={components} />
</ManualLayout>
